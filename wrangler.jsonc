{
  // Build Canada Project: bc-budget
  // Auto-generated by project provisioner
  "name": "bc-budget",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Non-sensitive environment variables
  "vars": {
      "ENVIRONMENT": "production",
      "PROJECT_NAME": "bc-budget",
      "PROJECT_DOMAIN": "bc-budget.canadasbuilding.com",
      "SUPABASE_URL": "https://api.buildcanada.com",
      "SMTP_HOST": "email-smtp.ca-central-1.amazonaws.com",
      "SMTP_PORT": 587,
      "OAUTH_CLIENT_ID": "06cf7959-e363-4ea6-858d-2446a9c719fd"
  },
  "r2_buckets": [
      {
          "binding": "R2_PUBLIC",
          "bucket_name": "buildcanada-prod-bc-budget"
      },
      {
          "binding": "R2_PRIVATE",
          "bucket_name": "buildcanada-prod-bc-budget-private"
      }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "be94366577534df4bde75dba29fe18cc"
    }
  ],
  // Queue producer: send messages to the notifications queue
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATIONS_QUEUE",
        "queue": "bc-budget-notifications"
      }
    ],
    "consumers": [
      {
        "queue": "bc-budget-notifications",
        "max_batch_size": 10,
        "max_retries": 3
      }
    ]
  },
  "browser": {
    "binding": "BROWSER"
  },
  // Cron triggers
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
